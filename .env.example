# ---------------------------------------------------------------------------
# Copy to .env (or run ./scripts/init-env.sh, which also generates secrets).
# Do NOT wrap values in quotes. NEVER commit the real .env file.
# ---------------------------------------------------------------------------

# Active Spring profile: dev | prod
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# --- PostgreSQL ---
# DB_HOST is "localhost" when the app runs on your machine.
# docker-compose.yml overrides it to "postgres" for the app container.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=appdb
DB_USERNAME=app
DB_PASSWORD=change-me

# --- JWT ---
# Base64-encoded secret, at least 32 bytes. Generate with:
#   openssl rand -base64 48
JWT_SECRET=change-me
# Access token lifetime (Spring Duration format: 30m, 1h, 2d ...)
JWT_EXPIRATION=60m

# --- CORS (comma separated origins) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Optional: create an ADMIN user on startup if it does not exist yet ---
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=Administrator

# --- Swagger UI / OpenAPI docs (defaults: true in dev, false in prod) ---
SWAGGER_ENABLED=true
